{
  "realm": "bi-platform",
  "displayName": "BI Platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "bi-admin",
        "description": "Toan quyen: quan ly user, data source, dashboard"
      },
      {
        "name": "bi-creator",
        "description": "Tao va chinh sua project, dataset, data model, chart, report"
      },
      {
        "name": "bi-viewer",
        "description": "Chi xem dashboard duoc chia se"
      }
    ]
  },
  "clients": [
    {
      "clientId": "bi-frontend",
      "name": "BI Platform Frontend (React SPA)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-bi-backend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bi-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bi-backend",
      "name": "BI Platform Backend API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "backend-client-secret-change-me",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "900"
      }
    }
  ],
  "users": [
    {
      "username": "bi.admin",
      "email": "admin@bi-platform.local",
      "firstName": "BI",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin@123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "bi-admin"
      ]
    },
    {
      "username": "bi.creator",
      "email": "creator@bi-platform.local",
      "firstName": "BI",
      "lastName": "Creator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Creator@123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "bi-creator"
      ]
    },
    {
      "username": "bi.viewer",
      "email": "viewer@bi-platform.local",
      "firstName": "BI",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Viewer@123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "bi-viewer"
      ]
    }
  ]
}

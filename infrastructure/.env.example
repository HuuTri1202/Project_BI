# =============================================================================
# Hạ tầng Docker — copy file này thành .env.
#
# ⚠️ Mọi mật khẩu dưới đây là CHỖ GIỮ CHỖ, không phải giá trị dùng thật.
# `npm run setup` thay chúng bằng chuỗi ngẫu nhiên riêng cho từng máy, và ghi
# cùng một giá trị sang `backend/.env` để hai bên khớp nhau. Xem
# `scripts/init-env.mjs`. File `.env` đã có thì tuyệt đối không bị đụng tới.
#
# Đừng sửa giá trị ở đây để "đổi mật khẩu": sửa trong `.env` của máy mình.
# =============================================================================

# --- Chọn profile mặc định ---
# Bỏ trống = chỉ chạy service lõi (mysql, redis).
# Đặt sẵn ở đây thì khỏi phải gõ --profile mỗi lần.
#   COMPOSE_PROFILES=data,bi
COMPOSE_PROFILES=

# --- MySQL (OLTP: toàn bộ metadata của ứng dụng) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=bi_platform
MYSQL_USER=bi_user
MYSQL_PASSWORD=bi_password
# 3310 chứ không phải 3306: tránh đụng MySQL cài sẵn trên máy
MYSQL_PORT=3310

# --- Redis (đếm nhịp chống dò mật khẩu + cache kết quả phân tích tệp) ---
REDIS_PASSWORD=redispassword
REDIS_PORT=6379

# --- MinIO (object storage, giao thức tương thích S3) ---
# Code dùng @aws-sdk/client-s3 y hệt khi lên AWS thật, chỉ khác S3_ENDPOINT.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=bi-datasets

# --- ClickHouse (OLAP: kho dữ liệu phân tích) ---
CLICKHOUSE_DB=bi_analytics
CLICKHOUSE_USER=bi_user
CLICKHOUSE_PASSWORD=clickhouse_password
CLICKHOUSE_HTTP_PORT=8123
# Cổng native mặc định của ClickHouse là 9000 — ĐỤNG MinIO API, nên map ra 9002
CLICKHOUSE_NATIVE_PORT=9002

# --- Cube.js (tầng ngữ nghĩa) ---
# Cube mặc định chạy cổng 4000 — ĐỤNG Express, nên map ra 4100
CUBEJS_PORT=4100
# Express dùng secret này để ký JWT ngắn hạn mang securityContext (F7).
# Cube không bao giờ được expose thẳng ra trình duyệt.
CUBEJS_API_SECRET=cube-api-secret-change-me
# Playground của Cube — giao diện tự soạn và chạy truy vấn, KHÔNG đòi token.
#
# Tiện khi dev (mở localhost:4100 là dò được schema đã sinh), nhưng trên một máy
# có IP công khai thì nó là đường đọc thẳng toàn bộ kho dữ liệu của mọi tổ chức,
# bỏ qua cả xác thực của Express lẫn `securityContext` của Cube.
#
# Nên `docker-compose.yml` mặc định FALSE: một bản triển khai không khai gì cả
# thì KHÔNG mở sẵn cửa đó. Dòng dưới đây bật lại cho máy dev.
CUBEJS_DEV_MODE=true
# Cube từ chối JWT có `iat` ở tương lai. Container Docker Desktop hay lệch đồng
# hồ vài phút so với host, nên nới dung sai ở đây khi gặp lỗi "token used before
# issued". Mặc định 300 giây, khai trong docker-compose.yml.
#   CUBEJS_CLOCK_TOLERANCE=300

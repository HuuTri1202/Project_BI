# =============================================================================
# Hạ tầng Docker — copy file này thành .env.
#
# Đây là mật khẩu môi trường DEV. Đừng dùng lại ở bất kỳ đâu khác.
# =============================================================================

# --- Chọn profile mặc định ---
# Bỏ trống = chỉ chạy 3 service lõi (mysql, redis, keycloak).
# Đặt sẵn ở đây thì khỏi phải gõ --profile mỗi lần.
#   COMPOSE_PROFILES=data,bi
#   COMPOSE_PROFILES=data,bi,stream,tools
COMPOSE_PROFILES=

# --- MySQL (OLTP: metadata vận hành + DB của Keycloak/Strapi + source_db cho CDC) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=bi_platform
MYSQL_USER=bi_user
MYSQL_PASSWORD=bi_password
# 3310 chứ không phải 3306: tránh đụng MySQL cài sẵn trên máy
MYSQL_PORT=3310

# --- Redis (cache quyết định Casbin + cache metadata Strapi) ---
REDIS_PASSWORD=redispassword
REDIS_PORT=6379

# --- Keycloak (IdP / OIDC) ---
# 8081 chứ không phải 8080: 8080 hay bị Tomcat/Jenkins/project khác chiếm
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
# Database riêng của Keycloak trong container MySQL
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_password

# --- MinIO (object storage, giao thức tương thích S3) ---
# Code dùng @aws-sdk/client-s3 y hệt khi lên AWS thật, chỉ khác S3_ENDPOINT.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=bi-datasets

# --- ClickHouse (OLAP: kho dữ liệu phân tích) ---
CLICKHOUSE_DB=bi_analytics
CLICKHOUSE_USER=bi_user
CLICKHOUSE_PASSWORD=clickhouse_password
CLICKHOUSE_HTTP_PORT=8123
# Cổng native mặc định của ClickHouse là 9000 — ĐỤNG MinIO API, nên map ra 9002
CLICKHOUSE_NATIVE_PORT=9002

# --- Cube.js (tầng ngữ nghĩa) ---
# Cube mặc định chạy cổng 4000 — ĐỤNG Express, nên map ra 4100
CUBEJS_PORT=4100
# Express dùng secret này để ký JWT ngắn hạn mang securityContext (F7).
# Cube không bao giờ được expose thẳng ra trình duyệt.
CUBEJS_API_SECRET=cube-api-secret-change-me

# --- Kafka + Debezium Connect (Event-Driven / CDC) ---
# Container khác gọi kafka:9092. Máy host gọi localhost:29092 (listener riêng).
KAFKA_HOST_PORT=29092
CONNECT_PORT=8083

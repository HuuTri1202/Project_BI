# =============================================================================
# Open Insight - .gitignore
# =============================================================================

# --- Secrets / biến môi trường ---
# KHÔNG commit .env (chứa password MySQL, Redis, MinIO, ClickHouse, secret ký JWT).
# Chỉ commit .env.example làm mẫu.
.env
.env.*
!.env.example
!.env.*.example
*.local

# Certificate / key
*.pem
*.key
*.crt
*.p12
*.jks
secrets/

# --- Node.js ---
node_modules/
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build output ---
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.vite/

# --- Test / coverage ---
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# --- Cache ---
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.turbo/
.temp/
tmp/
temp/

# --- Logs ---
logs/
*.log

# --- Docker / infrastructure ---
# Dữ liệu container nếu dùng bind mount thay vì named volume
infrastructure/data/
infrastructure/**/data/
docker-compose.override.yml

# Thư mục schema ĐỜI ĐẦU, từ trước khi §10 chuyển sang một thư mục mỗi tổ chức.
# Đã xoá khỏi repo. Dòng này ở lại vì máy nào từng chạy bản cũ vẫn còn file sót
# trên đĩa, và ta không muốn chúng quay lại Git qua một lần `git add .`.
infrastructure/cube/model/cubes/

# Cube tự sinh file mẫu này trong container lúc khởi động lần đầu; toàn bộ nội
# dung là chú thích. Không phải mã của ta, và nó quay lại sau mỗi lần dựng mới.
infrastructure/cube/model/views/
# §10 sinh MỘT THƯ MỤC MỖI TỔ CHỨC ở đây — `model/tenants/{tenantId}/dm{id}.js`.
# Chúng mang dữ liệu thật của khách hàng (tên bảng, tên cột) và được dựng lại từ
# database mỗi lần backend khởi động, nên không có lý do gì để nằm trong Git.
infrastructure/cube/model/tenants/


# Dump database
*.sql.gz
*.dump
backup/
dumps/

# --- IDE / editor ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.sublime-workspace
*~

# --- OS ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
.fuse_hidden*
.Trash-*

# --- Công cụ AI / trợ lý code (cấu hình cục bộ từng máy) ---
.claude/
.cursor/
.aider*

# --- Khác ---
.history/
*.bak
*.orig

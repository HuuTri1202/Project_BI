# =============================================================================
# BI Platform - .gitignore
# =============================================================================

# --- Secrets / biến môi trường ---
# KHÔNG commit .env (chứa password MySQL, Redis, MinIO, ClickHouse, secret ký JWT).
# Chỉ commit .env.example làm mẫu.
.env
.env.*
!.env.example
!.env.*.example
*.local

# Certificate / key
*.pem
*.key
*.crt
*.p12
*.jks
secrets/

# --- Node.js ---
node_modules/
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build output ---
dist/
dist-ssr/
build/
out/
*.tsbuildinfo
.vite/

# --- Test / coverage ---
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# --- Cache ---
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.turbo/
.temp/
tmp/
temp/

# --- Logs ---
logs/
*.log

# --- Docker / infrastructure ---
# Dữ liệu container nếu dùng bind mount thay vì named volume
infrastructure/data/
infrastructure/**/data/
docker-compose.override.yml

# Schema Cube.js do Express SINH RA lúc chạy (xem ADR-08), không phải mã nguồn.
# Giữ .gitkeep để git còn tạo được thư mục sau khi clone.
infrastructure/cube/model/cubes/*
!infrastructure/cube/model/cubes/.gitkeep
# §10 sinh MỘT THƯ MỤC MỖI TỔ CHỨC ở đây — `model/tenants/{tenantId}/dm{id}.js`.
# Chúng mang dữ liệu thật của khách hàng (tên bảng, tên cột) và được dựng lại từ
# database mỗi lần backend khởi động, nên không có lý do gì để nằm trong Git.
infrastructure/cube/model/tenants/

# Sản phẩm biên dịch của dbt
infrastructure/dbt/target/
infrastructure/dbt/dbt_packages/
infrastructure/dbt/logs/
# dbt tự sinh file này chứa id tracking ẩn danh, khác nhau trên mỗi máy
infrastructure/dbt/.user.yml

# Dump database
*.sql.gz
*.dump
backup/
dumps/

# --- IDE / editor ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.sublime-workspace
*~

# --- OS ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
.fuse_hidden*
.Trash-*

# --- Công cụ AI / trợ lý code (cấu hình cục bộ từng máy) ---
.claude/
.cursor/
.aider*

# --- Khác ---
.history/
*.bak
*.orig

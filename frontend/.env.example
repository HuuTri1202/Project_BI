# =============================================================================
# Frontend (Vite) — copy file này thành .env.
#
# CẢNH BÁO: mọi biến VITE_* đều được NHÚNG THẲNG vào bundle và người dùng cuối
# đọc được. Tuyệt đối không đặt secret ở đây (client secret của Keycloak, API
# token của Strapi, khoá S3...). Frontend dùng public client + PKCE nên không
# cần secret nào cả.
# =============================================================================

# Đường dẫn API. Để nguyên đường dẫn tương đối để đi qua proxy của Vite khi dev.
VITE_API_BASE_URL=/api/v1

# Backend mà dev server proxy tới (chỉ dùng lúc dev, không vào bundle)
VITE_API_PROXY_TARGET=http://localhost:4000

# --- Keycloak (public client, PKCE S256) ---
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=bi-platform
VITE_KEYCLOAK_CLIENT_ID=bi-frontend

{
  /**
   * Config CHỈ để type-check, không emit gì cả.
   *
   * Vì sao phải có file thứ hai: `tsconfig.json` đặt `rootDir: "src"` và
   * `include: ["src/**\/*.ts"]`, nên thư mục `tests/` (cố ý nằm NGOÀI `src/` để
   * `tsc` không gói test vào `dist/`) sẽ không được kiểm kiểu bao giờ.
   *
   * Vitest chạy bằng esbuild và không hề gọi `tsc`, nên test vẫn chạy dù có
   * file này hay không — nó tồn tại thuần tuý để `npm run verify` bắt được lỗi
   * kiểu trong test.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}

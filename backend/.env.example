# =============================================================================
# Backend (Express) — copy file này thành .env rồi chỉnh nếu cần.
# src/config/env.ts validate bằng zod lúc boot: thiếu biến bắt buộc thì process
# thoát ngay kèm tên biến đó.
# =============================================================================

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- MySQL (OLTP / metadata vận hành của Express) ---
# Port 3310 chứ không phải 3306: tránh đụng MySQL cài sẵn trên máy.
MYSQL_HOST=localhost
MYSQL_PORT=3310
MYSQL_DATABASE=bi_platform
MYSQL_USER=bi_user
MYSQL_PASSWORD=bi_password

# --- Redis (chống dò mật khẩu; sau này thêm cache phân quyền) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# --- Xác thực (JWT ký bằng HS256) ---
# BẮT BUỘC, tối thiểu 32 ký tự. Sinh chuỗi mới bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mỗi môi trường một secret riêng. Đổi secret = mọi phiên đang đăng nhập bị huỷ.
JWT_SECRET=thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu-truoc-khi-deploy

# Các biến dưới đây đều có giá trị mặc định, để trống cũng chạy được.
JWT_EXPIRES_IN=7d
JWT_ISSUER=bi-platform
JWT_AUDIENCE=bi-platform-api

# Chi phí băm bcrypt. Đo trên máy dev: 12 ≈ 291 ms.
BCRYPT_COST=12

# Sai quá LOGIN_MAX_ATTEMPTS lần trong LOGIN_LOCKOUT_MINUTES phút -> 429.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# --- Kết nối tới CSDL của khách hàng (§8) ---
# BẮT BUỘC. Khoá AES-256-GCM mã hoá mật khẩu CSDL nguồn. Sinh khoá mới bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ⚠️ Đổi khoá này = MỌI kết nối đã lưu ngừng giải mã được và phải nhập lại mật
# khẩu. Không có đường khôi phục. Mỗi môi trường một khoá riêng.
CONNECTION_ENCRYPTION_KEY=thay-bang-32-byte-ngau-nhien-ma-hoa-base64==

# Địa chỉ mà CSDL của khách hàng nhìn thấy khi hệ thống kết nối tới. Hiện ở bước
# 1 của wizard để họ thêm vào tường lửa. Ở local thì để gì cũng được.
EGRESS_IP=127.0.0.1

# Cho phép kết nối tới host nội bộ / loopback.
# Bỏ trống = theo môi trường: development BẬT, production TẮT.
#
# ⚠️ Bật ở production nghĩa là admin của bất kỳ tổ chức nào cũng trỏ được vào
# 169.254.169.254 (metadata cloud) hay bất kỳ máy nào trong mạng nội bộ, dùng
# chính server này làm bàn đạp. Chỉ bật khi thật sự cần và đã hiểu hậu quả.
# ALLOW_PRIVATE_DB_HOSTS=true

# --- Seed tài khoản quản trị đầu tiên (npm run seed:admin) ---
# Chỉ script seed đọc tới. Đổi mật khẩu ngay sau lần đăng nhập đầu.
SEED_TENANT_NAME=BI Platform
SEED_TENANT_SLUG=bi-platform
SEED_ADMIN_EMAIL=admin@bi-platform.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FULL_NAME=Quản trị viên

# --- Object storage cho file người dùng tải lên (§7.4) ---
# Dev dùng MinIO trong infrastructure/docker-compose.yml, cần bật profile `data`:
#   docker compose --profile data up -d
# Lên AWS S3 thật thì chỉ đổi bốn biến này, không sửa dòng code nào.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bi-datasets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
# MinIO cần true (bucket nằm trên đường dẫn). AWS S3 thật thì đặt false.
S3_FORCE_PATH_STYLE=true

# Trần dung lượng file (50MB) và số dòng nạp vào ClickHouse cho mỗi bộ dữ liệu.
#
# DATASET_MAX_ROWS từng là 50.000, và con số đó KHÔNG đến từ ClickHouse mà đến
# từ chỗ dữ liệu đọng lại trên đường đi — cache phân tích trong một khoá Redis và
# một bản sao JSON đầy đủ trong `dataset_rows`. Sau khi §9 đọc thẳng file để nạp,
# chi phí lưu trữ không còn tăng theo con số này. Đo trên máy dev: 500.000 dòng
# parse hết 1,1 giây và nạp ở 388.000 dòng/giây.
UPLOAD_MAX_BYTES=52428800
DATASET_MAX_ROWS=1000000

# --- Kho phân tích ClickHouse (§9) ---
# BẮT BUỘC. Đây là kho của CHÍNH TA (có GHI), khác hẳn phần kết nối tới CSDL của
# khách hàng ở §8 (chỉ đọc, địa chỉ do người dùng gõ).
#
# ClickHouse nằm trong infrastructure/docker-compose.yml và đã được start-dev.sh
# khởi động cùng nhóm lõi. Cổng 8123 là cổng HTTP (không TLS) — chạy trong mạng
# Docker nội bộ nên không cần, và cũng vì thế TUYỆT ĐỐI không mở nó ra Internet.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=bi_analytics
CLICKHOUSE_USER=bi_user
CLICKHOUSE_PASSWORD=clickhouse_password

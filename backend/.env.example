# =============================================================================
# Backend (Express) — copy file này thành .env rồi chỉnh nếu cần.
# Mọi biến ở đây đều BẮT BUỘC: src/config/env.ts validate bằng zod lúc boot,
# thiếu biến nào thì process thoát ngay kèm tên biến đó.
# =============================================================================

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- MySQL (OLTP / metadata vận hành của Express) ---
# Port 3310 chứ không phải 3306: tránh đụng MySQL cài sẵn trên máy.
MYSQL_HOST=localhost
MYSQL_PORT=3310
MYSQL_DATABASE=bi_platform
MYSQL_USER=bi_user
MYSQL_PASSWORD=bi_password

# --- Redis (cache quyết định Casbin + cache metadata Strapi) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# --- Xác thực (JWT trong cookie httpOnly) ---
# ĐỔI giá trị này ở production. Sinh khoá mới:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=doi-gia-tri-nay-bang-mot-chuoi-ngau-nhien-toi-thieu-32-ky-tu
JWT_ACCESS_TTL=1h
AUTH_COOKIE_NAME=bi_session
BCRYPT_COST=12

# =============================================================================
# Backend (Express) — copy file này thành .env rồi chỉnh nếu cần.
# Mọi biến ở đây đều BẮT BUỘC: src/config/env.ts validate bằng zod lúc boot,
# thiếu biến nào thì process thoát ngay kèm tên biến đó.
# =============================================================================

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- MySQL (OLTP / metadata vận hành của Express) ---
# Port 3310 chứ không phải 3306: tránh đụng MySQL cài sẵn trên máy.
MYSQL_HOST=localhost
MYSQL_PORT=3310
MYSQL_DATABASE=bi_platform
MYSQL_USER=bi_user
MYSQL_PASSWORD=bi_password

# --- Redis (cache quyết định Casbin + cache metadata Strapi) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# --- Keycloak (OIDC) ---
# Backend KHÔNG tự ký token. Nó chỉ verify token do Keycloak ký, bằng RS256 +
# JWKS. Vì vậy ở đây KHÔNG có JWT_SECRET — một secret đối xứng nằm sẵn chỉ mời
# gọi việc ký nhầm bằng HS256, vốn là lỗ hổng xác thực kinh điển.
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=bi-platform
KEYCLOAK_ISSUER=http://localhost:8081/realms/bi-platform
KEYCLOAK_JWKS_URI=http://localhost:8081/realms/bi-platform/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=bi-backend
KEYCLOAK_CLIENT_SECRET=backend-client-secret-change-me

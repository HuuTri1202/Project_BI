{
  "name": "bi-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BI Platform backend API (Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node ../scripts/free-ports.mjs 4000",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "backfill:personal": "tsx src/scripts/backfill-personal-tenants.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:ch": "vitest run --config vitest.integration.ch.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1108.0",
    "@bi/shared": "*",
    "@clickhouse/client": "1.23.1",
    "bcryptjs": "3.0.3",
    "casbin": "^5.51.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "9.0.3",
    "jszip": "3.10.1",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "papaparse": "^5.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
